<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PalmierPro.App.Editor.ProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PalmierPro.App.Editor"
    xmlns:timeline="using:PalmierPro.App.TimelineUI">

    <Grid Background="{ThemeResource BackgroundBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- Title bar strip -->
        <Grid Grid.Row="0" Background="{ThemeResource BackgroundSurfaceBrush}">
            <TextBlock x:Name="ProjectNameText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
        </Grid>

        <!-- Main: media panel | preview | inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- Media panel -->
            <Grid Grid.Column="0" Background="{ThemeResource BackgroundSurfaceBrush}"
                  BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,10">
                    <TextBlock Text="Media" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button x:Name="ImportButton" Content="Import" FontSize="12"
                            Padding="10,4" Click="OnImportClicked" />
                </StackPanel>

                <GridView x:Name="MediaGrid" Grid.Row="1" Padding="8"
                          SelectionMode="Single" IsItemClickEnabled="True"
                          ItemsSource="{x:Bind ViewModel.MediaItems, Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:MediaItemViewModel">
                            <StackPanel Width="126" Spacing="4" Loaded="OnMediaTileLoaded">
                                <Grid Width="126" Height="72" CornerRadius="{StaticResource RadiusXsSm}"
                                      Background="{ThemeResource BackgroundRaisedBrush}">
                                    <FontIcon Glyph="&#xE714;" FontSize="20"
                                              Foreground="{ThemeResource TextMutedBrush}" />
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border Background="{ThemeResource MediaOverlayBackgroundBrush}"
                                            Opacity="0.7" CornerRadius="{StaticResource RadiusXs}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="4" Padding="4,1"
                                            Visibility="{x:Bind DurationBadgeVisibility}">
                                        <TextBlock Text="{x:Bind DurationText}" FontSize="10"
                                                   Foreground="{ThemeResource MediaOverlayPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource MediaOverlayBackgroundBrush}"
                                            Opacity="0.8" Visibility="{x:Bind OfflineVisibility}">
                                        <TextBlock Text="Media Offline" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource MediaOverlaySecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontSize="11" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Grid.Row="2" x:Name="StatusTextBlock" Padding="12,6" FontSize="11"
                           Foreground="{ThemeResource TextTertiaryBrush}"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </Grid>

            <!-- Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <SwapChainPanel x:Name="PreviewPanel" Grid.Row="0" SizeChanged="OnPreviewSizeChanged" />

                <!-- Transport -->
                <Grid Grid.Row="1" Padding="16,8" Background="{ThemeResource BackgroundSurfaceBrush}"
                      BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button Click="OnStepBackClicked" Padding="8,4">
                            <FontIcon Glyph="&#xE892;" FontSize="12" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Click="OnPlayPauseClicked" Padding="10,4">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
                        </Button>
                        <Button Click="OnStepForwardClicked" Padding="8,4">
                            <FontIcon Glyph="&#xE893;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontSize="13" FontFamily="Consolas"
                               Foreground="{ThemeResource AccentTimecodeBrush}"
                               Text="{x:Bind ViewModel.TimecodeText, Mode=OneWay}" />

                    <Slider x:Name="ScrubSlider" Grid.Column="2" Minimum="0" VerticalAlignment="Center"
                            IsThumbToolTipEnabled="False"
                            Maximum="{x:Bind ViewModel.DurationFrames, Mode=OneWay}"
                            ValueChanged="OnScrubValueChanged"
                            PointerCaptureLost="OnScrubEnded" />
                </Grid>
            </Grid>

            <!-- Inspector -->
            <Grid Grid.Column="2" Background="{ThemeResource BackgroundSurfaceBrush}"
                  BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
                <local:InspectorPanel x:Name="Inspector" />
            </Grid>
        </Grid>

        <!-- Timeline -->
        <Grid Grid.Row="2" Background="{ThemeResource BackgroundSurfaceBrush}"
              BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <timeline:TimelineControl x:Name="TimelineView" />
        </Grid>
    </Grid>
</Window>
