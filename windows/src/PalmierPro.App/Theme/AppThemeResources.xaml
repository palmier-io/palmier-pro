<!-- Design system ported from Sources/PalmierPro/UI/AppTheme.swift. All UI styling must use these resources. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="BackgroundBaseColor">#FF0A0A0A</Color>
            <Color x:Key="BackgroundSurfaceColor">#FF141414</Color>
            <Color x:Key="BackgroundRaisedColor">#FF1C1C1C</Color>
            <Color x:Key="BackgroundProminentColor">#FF2A2A2A</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#CCFFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#9EFFFFFF</Color>
            <Color x:Key="TextMutedColor">#57FFFFFF</Color>
            <Color x:Key="BorderPrimaryColor">#29FFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#1FFFFFFF</Color>
            <Color x:Key="BorderDividerColor">#70FFFFFF</Color>
            <Color x:Key="AccentPrimaryColor">#FFF5EFE4</Color>
            <Color x:Key="AccentTimecodeColor">#FFF29933</Color>
            <Color x:Key="StatusErrorColor">#FFE54F4F</Color>
            <Color x:Key="StatusSuccessColor">#FF4FB85F</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BackgroundBaseColor">#FF0A0A0A</Color>
            <Color x:Key="BackgroundSurfaceColor">#FF141414</Color>
            <Color x:Key="BackgroundRaisedColor">#FF1C1C1C</Color>
            <Color x:Key="BackgroundProminentColor">#FF2A2A2A</Color>
            <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
            <Color x:Key="TextSecondaryColor">#CCFFFFFF</Color>
            <Color x:Key="TextTertiaryColor">#9EFFFFFF</Color>
            <Color x:Key="TextMutedColor">#57FFFFFF</Color>
            <Color x:Key="BorderPrimaryColor">#29FFFFFF</Color>
            <Color x:Key="BorderSubtleColor">#1FFFFFFF</Color>
            <Color x:Key="BorderDividerColor">#70FFFFFF</Color>
            <Color x:Key="AccentPrimaryColor">#FFF5EFE4</Color>
            <Color x:Key="AccentTimecodeColor">#FFF29933</Color>
            <Color x:Key="StatusErrorColor">#FFE54F4F</Color>
            <Color x:Key="StatusSuccessColor">#FF4FB85F</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BackgroundBaseColor">#FFE0E0E0</Color>
            <Color x:Key="BackgroundSurfaceColor">#FFEDEDED</Color>
            <Color x:Key="BackgroundRaisedColor">#FFF5F5F5</Color>
            <Color x:Key="BackgroundProminentColor">#FFF9F9F9</Color>
            <Color x:Key="TextPrimaryColor">#F0000000</Color>
            <Color x:Key="TextSecondaryColor">#C7000000</Color>
            <Color x:Key="TextTertiaryColor">#A3000000</Color>
            <Color x:Key="TextMutedColor">#70000000</Color>
            <Color x:Key="BorderPrimaryColor">#3D000000</Color>
            <Color x:Key="BorderSubtleColor">#2E000000</Color>
            <Color x:Key="BorderDividerColor">#70000000</Color>
            <Color x:Key="AccentPrimaryColor">#FF2E2921</Color>
            <Color x:Key="AccentTimecodeColor">#FF944A05</Color>
            <Color x:Key="StatusErrorColor">#FFB32417</Color>
            <Color x:Key="StatusSuccessColor">#FF177347</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Root brushes (ThemeResource colors) — live RequestedTheme switches update these. -->
    <SolidColorBrush x:Key="BackgroundBaseBrush" Color="{ThemeResource BackgroundBaseColor}" />
    <SolidColorBrush x:Key="BackgroundSurfaceBrush" Color="{ThemeResource BackgroundSurfaceColor}" />
    <SolidColorBrush x:Key="BackgroundRaisedBrush" Color="{ThemeResource BackgroundRaisedColor}" />
    <SolidColorBrush x:Key="BackgroundProminentBrush" Color="{ThemeResource BackgroundProminentColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderPrimaryBrush" Color="{ThemeResource BorderPrimaryColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderDividerBrush" Color="{ThemeResource BorderDividerColor}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{ThemeResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentTimecodeBrush" Color="{ThemeResource AccentTimecodeColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{ThemeResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{ThemeResource StatusSuccessColor}" />

    <!-- Media overlays are theme-invariant (always over dark imagery). -->
    <SolidColorBrush x:Key="MediaOverlayBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MediaOverlayPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MediaOverlaySecondaryBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="MediaOverlayTertiaryBrush" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="MediaOverlayMutedBrush" Color="#57FFFFFF" />

    <!-- Timeline clip colors (Mac TimelineClipColors defaults). -->
    <SolidColorBrush x:Key="TrackVideoBrush" Color="#FF1D5878" />
    <SolidColorBrush x:Key="TrackAudioBrush" Color="#FF2E7765" />
    <SolidColorBrush x:Key="TrackTextBrush" Color="#FF715486" />
    <SolidColorBrush x:Key="TrackAnimationBrush" Color="#FFA07822" />
    <SolidColorBrush x:Key="TrackSequenceBrush" Color="#FFB9B29A" />
    <SolidColorBrush x:Key="PlayheadBrush" Color="#FFFF453A" />

    <!-- Corner radii -->
    <CornerRadius x:Key="RadiusXs">3</CornerRadius>
    <CornerRadius x:Key="RadiusXsSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusMdLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">20</CornerRadius>

    <!-- Sidebar row buttons (HomeSidebar / Settings sidebar) -->
    <Style x:Key="SidebarRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Font sizes -->
    <x:Double x:Key="FontSizeMicro">8</x:Double>
    <x:Double x:Key="FontSizeXxs">9</x:Double>
    <x:Double x:Key="FontSizeXs">10</x:Double>
    <x:Double x:Key="FontSizeSm">11</x:Double>
    <x:Double x:Key="FontSizeSmMd">12</x:Double>
    <x:Double x:Key="FontSizeMd">13</x:Double>
    <x:Double x:Key="FontSizeMdLg">14</x:Double>
    <x:Double x:Key="FontSizeLg">15</x:Double>
    <x:Double x:Key="FontSizeXl">18</x:Double>
    <x:Double x:Key="FontSizeTitle1">22</x:Double>
    <x:Double x:Key="FontSizeTitle2">28</x:Double>
    <x:Double x:Key="FontSizeDisplay">36</x:Double>
</ResourceDictionary>
