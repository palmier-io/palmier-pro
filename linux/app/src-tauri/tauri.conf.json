{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palmier Pro",
  "version": "0.1.0",
  "identifier": "io.palmier.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Palmier Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "AI-native video editor",
    "longDescription": "Palmier Pro for Linux. Edit timelines, import media, generate assets, and export video.",
    "fileAssociations": [
      {
        "ext": ["palmier"],
        "name": "Palmier Project",
        "description": "Palmier Pro project package",
        "mimeType": "application/x-palmier-project",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libavcodec62",
          "libavformat62",
          "libavutil60",
          "libswresample6",
          "libswscale9",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libsecret-1-0"
        ],
        "files": {
          "/usr/share/mime/packages/palmier-pro.xml": "packaging/palmier-pro.xml",
          "/usr/share/applications/palmier-pro.desktop": "packaging/palmier-pro.desktop"
        },
        "section": "video",
        "priority": "optional"
      },
      "rpm": {},
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {}
}
